# Local development defaults
# Copy this file to `.dev.vars` and fill in any private keys you need.

VITE_API_URL=http://localhost:8000
VITE_SITE_URL=http://localhost:5173
# Public MLAI Chat distribution links used by `/community`.
VITE_MLAI_CHAT_WEB_URL=https://chat.mlai.au/
VITE_MLAI_CHAT_DESKTOP_URL=https://github.com/MLAI-AUS-Inc/mlai-chat/releases/latest
VITE_MLAI_CHAT_IOS_URL=
VITE_MLAI_CHAT_ANDROID_URL=
# Public Stripe Buy Button values for the one-time AUD donation Payment Link.
VITE_STRIPE_DONATION_BUY_BUTTON_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
LUMA_API_KEY=
# IndexNow ownership key used by the manual submit:indexnow command. Public by design
# (served at https://mlai.au/<key>.txt). Set in the build env; leave blank to
# skip IndexNow submission.
INDEXNOW_KEY=
