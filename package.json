{
  "name": "mlai-au",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": ">=1.2.15",
    "node": ">=18.0.0"
  },
  "scripts": {
    "test:arcade": "bun test tests/team-arcade-combat.test.ts tests/team-arcade-specials.test.ts tests/team-arcade-roster.test.ts tests/team-arcade-jump.test.ts",
    "test:arcade:browser": "playwright test --config playwright.arcade.config.ts",
    "check:article-internal-links": "bunx --yes tsx scripts/check-article-internal-links.ts",
    "generate:sitemap": "bunx --yes tsx scripts/generate-sitemap.ts",
    "prebuild": "bun run check:indexing && bun run check:article-integrity && bun test --timeout 30000 tests/article-integrity.test.ts tests/article-resource-integrity.test.tsx tests/article-review-disclosure.test.tsx tests/article-schema-ownership.test.tsx tests/reader-document-ssr.test.ts tests/article-pilot-evidence.test.tsx && bun run check:article-downloads && bun run generate:sitemap",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' react-router build",
    "cf-typegen": "bunx --yes wrangler types",
    "deploy": "bun run build && bunx --yes wrangler deploy",
    "dev": "node scripts/dev-local.mjs",
    "dev:node": "node scripts/dev-local.mjs",
    "preview": "bun run build && vite preview",
    "typegen": "bun run cf-typegen 1>/dev/null && react-router typegen",
    "typecheck": "react-router typegen && tsc -b && bun run check:article-internal-links",
    "check:article-integrity": "bun scripts/check-article-integrity.ts",
    "submit:indexnow": "bun scripts/submit-indexnow.ts",
    "check:article-downloads": "bun scripts/check-article-downloads.tsx",
    "test:articles:browser": "playwright test",
    "postbuild": "tsx scripts/build-public-pages.ts && bun scripts/check-article-downloads.tsx --built",
    "test": "bun test ./tests",
    "test:coverage": "bun scripts/run-coverage.ts",
    "test:coverage:check": "bun run test:coverage",
    "check:indexing": "bun test --timeout 30000 tests/search-indexing-sitemap.test.ts tests/article-pagination.test.ts tests/document-metadata.test.tsx tests/worker-request-policy.test.ts tests/substack-request-timeout.test.ts tests/search-indexing-reading-links.test.tsx tests/search-indexing-production-protection.test.ts tests/homepage-feed-fallback.test.tsx tests/homepage-deferred-budget.test.ts tests/server-cache.test.ts",
    "build:verify": "bun run build",
    "check:indexing:browser": "bun scripts/check-document-metadata-browser.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@rowanmanning/feed-parser": "^2.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "isbot": "^5.1.32",
    "jszip": "^3.10.1",
    "lucide-react": "^0.535.0",
    "phaser": "4.2.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^7.10.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.20.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^7.10.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/form-data": "^2.5.2",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.178.1",
    "happy-dom": "20.14.5",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "miniflare": "4.20260107.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.34.8",
    "@tailwindcss/oxide-linux-x64-gnu": "4.1.17",
    "lightningcss-linux-x64-gnu": "1.30.2"
  },
  "overrides": {
    "esbuild": "0.24.0"
  },
  "resolutions": {
    "esbuild": "0.24.0"
  }
}
